# AI Product Assistant - example environment.
# Copy to .env and fill in what you need. All values below are placeholders.
# Every variable is optional for local development unless noted; features
# whose credentials are missing are disabled or fall back gracefully.

# --- AZURE OPENAI ---
AZURE_OPENAI_ENDPOINT=https://<your-openai-resource>.openai.azure.com
AZURE_OPENAI_KEY=<your-azure-openai-key>
AZURE_OPENAI_BASE_URL=
AZURE_OPENAI_API_PREFIX=/openai
AZURE_OPENAI_AUTH_MODE=api-key
AZURE_OPENAI_AUTH_HEADER=api-key
AZURE_OPENAI_AUTH_VALUE=
CHAT_DEPLOYMENT=gpt-4-1-dz
EMBEDDING_DEPLOYMENT=text-embedding-3-small
EMBEDDING_VECTOR_DIMENSIONS=1536
API_VERSION_CHAT=2024-10-21
API_VERSION_OPENAI=2023-05-15

# --- AZURE SPEECH ---
AZURE_SPEECH_ENABLED=false
AZURE_SPEECH_KEY=<your-speech-key>
AZURE_SPEECH_REGION=<your-region>
AZURE_SPEECH_LANGUAGE=pt-PT
SPEECH_PROMPT_PRIMARY_SPEC=azure_openai:gpt-4-1-mini-dz
SPEECH_PROMPT_FALLBACK_SPEC=anthropic:sonnet
PROVIDER_GOVERNANCE_MODE=advisory
PROVIDER_EXTERNAL_MODEL_FAMILIES=anthropic

# --- ANTHROPIC (Claude) — via API directa OU via Azure AI Foundry ---
ANTHROPIC_API_KEY=<your-anthropic-or-foundry-key>
ANTHROPIC_FOUNDRY_RESOURCE=
ANTHROPIC_BASE_URL=
ANTHROPIC_MESSAGES_PATH=
ANTHROPIC_AUTH_MODE=api-key
ANTHROPIC_AUTH_HEADER=x-api-key
ANTHROPIC_AUTH_VALUE=
ANTHROPIC_MODEL_OPUS=claude-opus-4-6
ANTHROPIC_MODEL_SONNET=claude-sonnet-4-6
ANTHROPIC_MODEL_HAIKU=claude-haiku-4-5-20251001
APP_PUBLIC_URL=http://localhost:8000

# --- LLM PROVIDER CONFIG ---
LLM_DEFAULT_TIER=standard
LLM_TIER_FAST=azure_openai:gpt-4-1-dz
LLM_TIER_STANDARD=
LLM_TIER_PRO=anthropic:opus
LLM_TIER_VISION=azure_openai:gpt-4-1-dz
VISION_ENABLED=true
PII_ENDPOINT=https://<your-language-resource>.cognitiveservices.azure.com
PII_API_KEY=<your-language-key>
PII_ENABLED=true
CONTENT_SAFETY_ENDPOINT=https://<your-content-safety-resource>.cognitiveservices.azure.com
CONTENT_SAFETY_KEY=<your-content-safety-key>
PROMPT_SHIELD_ENABLED=true
PROMPT_SHIELD_FAIL_MODE=closed
DOC_INTEL_ENDPOINT=https://<your-doc-intelligence-resource>.cognitiveservices.azure.com
DOC_INTEL_KEY=<your-doc-intelligence-key>
DOC_INTEL_ENABLED=true
DOC_INTEL_MODEL=prebuilt-layout
LLM_FALLBACK=azure_openai:gpt-4-1-mini-dz

# --- AZURE AI SEARCH ---
SEARCH_SERVICE=<your-search-service>
SEARCH_KEY=<your-search-admin-key>
API_VERSION_SEARCH=2023-11-01
DEVOPS_INDEX=devops-index
OMNI_INDEX=omni-index
EXAMPLES_INDEX=examples-index
STORY_DEVOPS_INDEX=story-devops-index
STORY_KNOWLEDGE_INDEX=story-knowledge-index
STORY_EXAMPLES_INDEX=story-examples-index
STORY_LANE_ENABLED=true
STORY_CONTEXT_SIMILAR_TOP=5
STORY_CONTEXT_CURATED_TOP=4
STORY_CONTEXT_DOC_TOP=4
STORY_CONTEXT_FIGMA_FILES_TOP=2
STORY_CONTEXT_FIGMA_FLOW_TOP=4
STORY_MAX_CLARIFICATIONS=2
PPTX_VNEXT_ENABLED=true
PPTX_LEGACY_PLANNER_ENABLED=true

# --- POST-RETRIEVAL RERANK ---
RERANK_ENABLED=true
RERANK_ENDPOINT=https://<your-rerank-endpoint>
RERANK_API_KEY=<your-rerank-key>
RERANK_MODEL=cohere-rerank-v4-fast
RERANK_TOP_N=15
RERANK_TIMEOUT_SECONDS=15
RERANK_AUTH_MODE=api-key

# --- WEB SEARCH (Brave Search API) ---
WEB_SEARCH_ENABLED=false
WEB_SEARCH_API_KEY=<your-brave-search-key>
WEB_SEARCH_ENDPOINT=https://api.search.brave.com/res/v1/web/search
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_MARKET=pt-PT
WEB_ANSWERS_ENABLED=false
WEB_ANSWERS_API_KEY=<your-brave-answers-key>
WEB_ANSWERS_ENDPOINT=https://api.search.brave.com/res/v1/chat/completions
WEB_ANSWERS_MODEL=brave
WEB_ANSWERS_TIMEOUT_SECONDS=20
WEB_SEARCH_DAILY_QUOTA_PER_USER=50

# --- PPTX IMAGE / LOGO ENRICHMENT (via web search) ---
PPTX_LOGO_FETCH_ENABLED=false

# --- AZURE DEVOPS ---
DEVOPS_PAT=<your-azure-devops-pat>
DEVOPS_ORG=<your-devops-org>
DEVOPS_PROJECT=<your-devops-project>
DEVOPS_PROJECT_LABEL=Produto Digital

# --- FIGMA / MIRO (Read-Only Integrations) ---
FIGMA_ACCESS_TOKEN=<your-figma-token>
MIRO_ACCESS_TOKEN=<your-miro-token>

# --- AZURE TABLE STORAGE ---
STORAGE_CONNECTION_STRING=
STORAGE_ACCOUNT=<your-storage-account>
STORAGE_KEY=<your-storage-key>
UPLOAD_BLOB_CONTAINER_RAW=upload-raw
UPLOAD_BLOB_CONTAINER_TEXT=upload-text
UPLOAD_BLOB_CONTAINER_CHUNKS=upload-chunks
UPLOAD_BLOB_CONTAINER_ARTIFACTS=upload-artifacts
CHAT_TOOLRESULT_BLOB_CONTAINER=chat-tool-results
GENERATED_FILES_BLOB_CONTAINER=generated-files
GENERATED_FILE_TTL_SECONDS=1800
CHAT_HISTORY_TTL_DAYS=90

# --- AUTH ---
APP_ENV=dev
WEBSITE_SITE_NAME=
JWT_SECRET=<generate-a-long-random-string>
JWT_EXPIRATION_HOURS=2
JWT_REFRESH_WINDOW_MINUTES=30
ADMIN_INITIAL_PASSWORD=<choose-a-strong-password>
ADMIN_USERNAME=admin
ADMIN_DISPLAY_NAME=Administrator
AUTH_COOKIE_NAME=app_token
JWT_SECRET_PREVIOUS=
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_MAX_AGE_SECONDS=7200

# --- AGENT CONFIG ---
AGENT_MAX_ITERATIONS=7
AGENT_MAX_TOKENS=
AGENT_TEMPERATURE=0.3
AGENT_HISTORY_LIMIT=14
AGENT_TOOL_RESULT_MAX_SIZE=30000
AGENT_TOOL_RESULT_KEEP_ITEMS=100
CHAT_BUDGET_PER_MINUTE=10

# --- CODE INTERPRETER CONFIG ---
CODE_INTERPRETER_TIMEOUT=240
CODE_INTERPRETER_MAX_OUTPUT=50000
CODE_INTERPRETER_ENABLED=true
CODE_INTERPRETER_MAX_INPUT_FILE_BYTES=75000000
CODE_INTERPRETER_MAX_MOUNT_BYTES=150000000

# --- UPLOAD CONFIG ---
UPLOAD_MAX_FILES_PER_CONVERSATION=10
UPLOAD_MAX_IMAGES_PER_MESSAGE=10
UPLOAD_MAX_FILE_MB=100
UPLOAD_MAX_FILE_MB_CSV=200
UPLOAD_MAX_FILE_MB_TSV=
UPLOAD_MAX_FILE_MB_XLSX=200
UPLOAD_MAX_FILE_MB_XLSB=200
UPLOAD_MAX_FILE_MB_XLS=100
UPLOAD_MAX_CONCURRENT_JOBS=8
UPLOAD_MAX_PENDING_JOBS_PER_USER=20
UPLOAD_EMBEDDING_CONCURRENCY=10
UPLOAD_MAX_CHUNKS_PER_FILE=600
UPLOAD_TABULAR_DEEP_INGEST_MAX_MB=150
UPLOAD_TABULAR_DEEP_INGEST_MAX_ROWS=500000
UPLOAD_TABULAR_DEEP_INGEST_RECORD_LIMIT=100000
UPLOAD_JOB_STALE_SECONDS=900
UPLOAD_MAX_BATCH_TOTAL_MB=300
UPLOAD_INDEX_TOP=200
UPLOAD_INLINE_WORKER_ENABLED=true
UPLOAD_INLINE_WORKER_RUNTIME_ENABLED=true
UPLOAD_DEDICATED_WORKER_ENABLED=true
UPLOAD_WORKER_POLL_SECONDS=2.5
UPLOAD_WORKER_BATCH_SIZE=4
UPLOAD_TABULAR_ARTIFACT_ENABLED=true
UPLOAD_TABULAR_ARTIFACT_BATCH_ROWS=25000
UPLOAD_ARTIFACT_RETENTION_HOURS=72
UPLOAD_TABULAR_RAW_RETENTION_HOURS=6
UPLOAD_TABULAR_READY_RAW_RETENTION_HOURS=1
UPLOAD_TABULAR_CHUNK_BACKFILL_BATCH_SIZE=6
UPLOAD_RETENTION_SWEEP_INTERVAL_SECONDS=1800
UPLOAD_FRONTEND_ASYNC_THRESHOLD_MB=2

# --- EXPORT CONFIG ---
EXPORT_BRAND_COLOR=#6366F1
EXPORT_BRAND_NAME=Acme Corp
EXPORT_AGENT_NAME=AI Product Assistant
EXPORT_AUTO_ASYNC_ENABLED=true
EXPORT_ASYNC_THRESHOLD_ROWS=250
EXPORT_FILE_ROW_CAP=5000
EXPORT_FILE_ROW_CAP_MAX=100000
EXPORT_MAX_CONCURRENT_JOBS=4
EXPORT_JOB_STALE_SECONDS=1800
EXPORT_INLINE_WORKER_ENABLED=false
EXPORT_DEDICATED_WORKER_ENABLED=true
EXPORT_WORKER_POLL_SECONDS=2.0
EXPORT_WORKER_BATCH_SIZE=3

# --- WORKER PROCESS CONFIG ---
WORKER_RUN_DIR=/home/site/wwwroot/run
UPLOAD_WORKER_PID_FILE=
EXPORT_WORKER_PID_FILE=

# --- DEBUG ---
STARTUP_FAIL_FAST=true

# --- TOKEN QUOTAS (per tier, hourly/daily) ---
TOKEN_QUOTA_ENFORCEMENT_ENABLED=
TOKEN_QUOTA_FAST=
TOKEN_QUOTA_STANDARD=
TOKEN_QUOTA_PRO=
USER_DAILY_TOKEN_LIMIT=
WRITER_PROFILE_LEARN_THRESHOLD=3
PII_COLUMN_SCAN_ENABLED=true
PII_COLUMN_SCAN_SAMPLE_ROWS=50
DIGEST_FEEDBACK_SUMMARY_ENABLED=true

# --- CHAT RATE LIMITING ---
CHAT_RATE_LIMIT_ENFORCEMENT_ENABLED=false
ROUTE_RATE_LIMIT_ENFORCEMENT_ENABLED=true
DEBUG_LOG_SIZE=50
DEBUG_MODE=false
LOG_FORMAT=json
LOG_LEVEL=INFO

# --- Workers / runtime (read outside config.py) ---
PORT=8000
WORKER_MODE=both
WORKER_LOG_DIR=
WORKER_RESTART_DELAY_SECONDS=2.0
UPLOAD_WORKER_INSTANCE_ID=
EXPORT_WORKER_INSTANCE_ID=
UPLOAD_SCAN_BACKEND=none
CLAMD_HOST=127.0.0.1
CLAMD_PORT=3310
CLAMD_TIMEOUT_SECONDS=30
AUDIT_ENCRYPTION_KEY=

# --- Smoke test / eval ---
SMOKE_USER=admin
SMOKE_PASS=<smoke-test-password>
EVAL_MOCK_LLM=true
EVAL_RUNNER_TIMEOUT_SECONDS=600

# --- Frontend build (Vite) ---
VITE_DEVOPS_WORKITEM_BASE_URL=https://dev.azure.com/<your-devops-org>/<your-devops-project>/_workitems/edit/
